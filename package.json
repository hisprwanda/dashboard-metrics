    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.18",
    "framer-motion": "^12.23.14",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "lowlight": "^3.3.0",
    "postcss-cli": "^11.0.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
